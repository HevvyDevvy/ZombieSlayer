/* ZombieSlayer tactical theme: gunmetal chrome + blood red, matching the app logo */

* {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

QWidget {
    background-color: #0c0c0e;
    color: #d8d8dc;
}

QMainWindow {
    background-color: #0a0a0b;
}

/* ---- Header / brand ---- */
#BrandHeader {
    background-color: #131315;
    border-bottom: 2px solid #7a0d13;
}

#BrandTitle {
    color: #e6e6ea;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 2px;
}

#BrandSubtitle {
    color: #b0212b;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
}

/* ---- Status HUD ---- */
#StatusHud {
    background-color: #131315;
    border: 1px solid #2a2a2e;
    border-radius: 6px;
}

#StatusDotIdle {
    background-color: #3a3a3e;
    border-radius: 7px;
}

#StatusDotActive {
    background-color: #e21b2e;
    border-radius: 7px;
}

#StatusLabel {
    color: #9a9aa0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
}

/* ---- Tabs ---- */
QTabWidget::pane {
    border: 1px solid #2a2a2e;
    background-color: #101012;
    top: -1px;
}

QTabBar::tab {
    background-color: #131315;
    color: #8c8c92;
    padding: 10px 18px;
    border: 1px solid #2a2a2e;
    border-bottom: none;
    font-weight: 600;
    letter-spacing: 1px;
}

QTabBar::tab:selected {
    background-color: #1a1a1d;
    color: #e6e6ea;
    border-top: 2px solid #b0212b;
}

QTabBar::tab:hover:!selected {
    color: #c9c9ce;
}

/* ---- Tables (kill feed / allow list) ---- */
QTableWidget {
    background-color: #0f0f11;
    alternate-background-color: #131315;
    gridline-color: #232326;
    border: 1px solid #2a2a2e;
    selection-background-color: #3a0f13;
    selection-color: #f0f0f2;
}

QHeaderView::section {
    background-color: #1a1a1d;
    color: #9a9aa0;
    padding: 6px;
    border: none;
    border-bottom: 2px solid #7a0d13;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #1a1a1d;
    color: #e6e6ea;
    border: 1px solid #3a3a3e;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QPushButton:hover {
    border-color: #b0212b;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #b0212b;
}

QPushButton#DangerButton {
    background-color: #7a0d13;
    border: 1px solid #b0212b;
}

QPushButton#DangerButton:hover {
    background-color: #b0212b;
}

QPushButton#PrimaryButton {
    background-color: #1a1a1d;
    border: 1px solid #b0212b;
}

QPushButton#PrimaryButton:hover {
    background-color: #b0212b;
}

/* ---- Inputs ---- */
QLineEdit, QSpinBox {
    background-color: #101012;
    border: 1px solid #2a2a2e;
    border-radius: 4px;
    padding: 6px 8px;
    color: #e6e6ea;
    selection-background-color: #7a0d13;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #b0212b;
}

/* ---- Checkboxes ---- */
QCheckBox {
    color: #c9c9ce;
    spacing: 8px;
    padding: 3px 0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a3a3e;
    background-color: #101012;
}

QCheckBox::indicator:checked {
    background-color: #b0212b;
    border: 1px solid #e21b2e;
}

/* ---- Group boxes ---- */
QGroupBox {
    border: 1px solid #2a2a2e;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 12px;
    font-weight: 700;
    color: #9a9aa0;
    letter-spacing: 1px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #b0212b;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: #101012;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #2a2a2e;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #b0212b;
}

/* ---- Footer ---- */
#Footer {
    color: #5a5a60;
    font-size: 10px;
    font-style: italic;
    padding: 6px;
}
